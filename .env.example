# XiteAI Terminal — copy to .env and fill in.

# ── Database (MongoDB Atlas). Required: the server won't start without it. ──
# Free tier is plenty at this scale. Get MONGO_CLUSTER from Atlas → your
# cluster → Connect → Drivers (the host after the @ in the connection string,
# like cluster0.abcde.mongodb.net) and MONGO_DB_PASSWORD from the database
# user you created there. Every collection lives in one database on the
# cluster, named by TC_MONGO_DB_NAME (default below) — a different database on
# the same cluster is fine to reuse for something else entirely, nothing here
# touches it. Testing (tests/test_*.py) uses its own throwaway database name
# automatically and drops it when the run ends.
MONGO_CLUSTER=
MONGO_DB_PASSWORD=
TC_MONGO_DB_NAME=xiteai_terminal
MONGO_POOL_SIZE=20

# ── Founder (top of the hierarchy). Change the password here, then restart. ──
FOUNDER_EMAIL=suraj@xos1.com
FOUNDER_PASSWORD=change-me-to-something-long-1
FOUNDER_DISPLAY_NAME=Suraj Verma
FOUNDER_TITLE=Founder & CEO
# Base32 secret for an authenticator app (Google Authenticator etc.). Set it before going online.
FOUNDER_TOTP_SECRET=

# Optional starting staff, already approved: level:email:password:Full Name:Title ; separated
SEED_STAFF=

# ── Company ──
TC_COMPANY=XiteAI Technologies
TC_PRODUCT=XOS1
TC_PRODUCT_FULL=XiteAI OS1
TC_EMAIL_DOMAIN=xos1.com
TC_SUPPORT_EMAIL=

# ── Server ──
TC_HOST=127.0.0.1
TC_PORT=8710
TC_SESSION_HOURS=12
# true once served over HTTPS (xos1dashboard.xiteai.com)
TC_COOKIE_SECURE=false
TC_DISPLAY_UTC_OFFSET=+05:30
TC_DISPLAY_TZ_LABEL=IST

# ── Demo data (marked DEMO in the console; remove it from Account) ──
TC_DEMO_DATA=true

# ── XOS1 product facts for the customer page ──
XOS1_LATEST_VERSION=1.0.17
XOS1_RELEASE_NOTES_DIR=C:/path/to/XOS1/NON-SHIPPINGS/release_notes
XOS1_DOWNLOAD_URL=https://github.com/SURAj-Verma-ai/ella-zero-releases/releases/latest

# ── AI keys (the AI keys page sends replaced keys here; nothing is stored locally) ──
# Cloudflare dashboard → Secrets Store: the store's id. The token needs ONLY
# "Secrets Store Write" (it can't read keys back or change the Worker).
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_SECRETS_STORE_ID=

# ── Codebase ──
# Fine-grained token: Contents Read and write, on the one repository only.
GITHUB_TOKEN=
# Code and text only. Binary files (models, video, archives) are always refused.
TC_CODE_MAX_FILE_KB=1024
TC_CODE_MAX_CHANGE_MB=5
TC_CODE_MAX_FILES=50
# The reading alarm, per person per hour: tell the founder, then pause their code access.
TC_CODE_ALERT_FILES_HOUR=40
TC_CODE_PAUSE_FILES_HOUR=120
TC_CODE_ALERT_SEARCHES_HOUR=150
TC_CODE_PAUSE_SEARCHES_HOUR=400
# Daily offline copies of the whole history (git bundle); 0 turns them off.
TC_CODE_BACKUP_DIR=data/backups
TC_CODE_BACKUPS_KEEP=3

# ── Authenticator seeds are sealed with this key (a Fernet key). Keep a copy safe:
# lose it and everyone sets their authenticator up again. Empty = data/secret.key.
TC_SECRET_KEY=
