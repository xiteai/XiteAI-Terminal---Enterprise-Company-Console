# Secrets: passwords and keys live only here, never in git.
.env
.env.*
!.env.example

# Data: the database holds real people's details.
data/
*.db
*.db-*

# Builds and dependencies
dashboard/node_modules/
dashboard/dist/
__pycache__/
*.pyc
.venv/
venv/

# Leftovers
server/_old/
*.log
.DS_Store
Thumbs.db

# Screens being built (dev.py builds beside dist/, then swaps them in)
dashboard/.dist-next-*/

# The databases travel with the repo so work can move between machines.
# Their neighbours in data/ deliberately do not:
#   code/     git clones — a repo inside a repo, and re-cloned on demand
#   backups/  git bundles of that same history, regenerated daily
#   logs/     noise
#   secret.key  a key. Copy it by hand, like .env; never into git history.
!data/*.db
!data/*.json
